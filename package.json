    "check": "npm test && npm run build"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "node": "22.22.0",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
